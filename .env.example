# Cross The Bridge — Phase 1 staging
# Copy to `.env` (gitignored) and fill in values.
# All four vars MUST keep the PUBLIC_ prefix — Astro only inlines PUBLIC_* into client bundles.

# Canonical site URL (drives sitemap, OG image absolute URLs, JSON-LD URLs)
# Phase 1 staging: https://staging.crossthebridge.io
# Phase 3 cutover: https://crossthebridge.io
PUBLIC_SITE_URL=https://staging.crossthebridge.io

# Self-hosted Umami analytics (D-14). Leave both blank if Umami not yet wired —
# BaseLayout's three-way guard fails safe to "no analytics" when blank.
PUBLIC_UMAMI_HOST=
PUBLIC_UMAMI_WEBSITE_ID=

# AI/Petros project page CTA target (D-05). During Phase 1 staging,
# the apex still serves the legacy single-page consulting site, so
# this points to the apex. Phase 3 cutover unsets the var → falls
# back to the new in-repo /consulting route.
PUBLIC_CONSULTING_URL=https://crossthebridge.io
