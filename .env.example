# wesleyschlemmer.com — Phase 1 staging (post D-20 pivot 2026-04-27)
# Copy to `.env` (gitignored) and fill in values.
# All four vars MUST keep the PUBLIC_ prefix — Astro only inlines PUBLIC_* into client bundles.

# Canonical site URL (drives sitemap, OG image absolute URLs, JSON-LD URLs)
# Phase 1 staging: https://staging.wesleyschlemmer.com
# Phase 1 cutover: https://wesleyschlemmer.com
PUBLIC_SITE_URL=https://staging.wesleyschlemmer.com

# Self-hosted Umami analytics (D-14). Leave both blank if Umami not yet wired —
# BaseLayout's three-way guard fails safe to "no analytics" when blank.
# Endpoint host is `umami.crossthebridge.io` (CTB DNS zone — Wesley owns both
# zones; per D-14 this is acceptable even though the personal hub is now at
# wesleyschlemmer.com).
PUBLIC_UMAMI_HOST=
PUBLIC_UMAMI_WEBSITE_ID=

# Cross The Bridge project page CTA target (D-05 revised). The third project
# tile on the personal hub is a teaser that links OUT to the Cross The Bridge
# brand site at crossthebridge.io (currently the legacy single-page consulting
# site; eventually the new CTB brand site built by a separate future project).
# This var deliberately stays pointing at https://crossthebridge.io.
PUBLIC_CONSULTING_URL=https://crossthebridge.io
