---
/**
 * EssayLayout.astro — reading-optimized layout for essay pages.
 *
 * Composes BaseLayout (CD-07 — no second top-level layout). BaseLayout owns
 * the document head, Font preload (PRIV-01), conditional Umami (PRIV-02),
 * Nav, Footer, and the skip-link. This layout adds:
 *   - h-entry microformat container (SEO-06)
 *   - reading-time display when readingMinutes >= 1 (CD-09 essays-only)
 *   - "Related" block at the footer (WRITE-06; resolved via lib/relations.ts)
 *   - per-essay BlogPosting JSON-LD (CD-10) — passed through to BaseLayout
 *
 * D-30 date display:
 *   - Always show published date.
 *   - If updated is present, render it with at least equal weight after
 *     published (matches PITFALLS.md line 501 "hide pure pub-date on
 *     evergreen, give updated equal weight").
 *
 * Pitfall B (PRIV-01) and Pitfall C (PRIV-02) firewall: never re-implement
 * the document head; never bypass BaseLayout. If a future maintainer adds
 * head-level markup here, they break the no-Google-Fonts-CDN guarantee and
 * the Umami three-way guard.
 */
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { resolveRelated } from '../lib/relations';

interface Props {
  entry: CollectionEntry<'essays'>;
  readingMinutes?: number;
}

const { entry, readingMinutes } = Astro.props;
const { title, description, published, updated, subtitle, related } = entry.data;
const slug = entry.id.replace(/\.md$/, '');
const canonical = `/essays/${slug}`;
const relatedEntries = await resolveRelated(related);

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  jsonLdSchema="blog-posting"
  jsonLdData={{
    headline: title,
    datePublished: published.toISOString(),
    dateModified: updated?.toISOString(),
    description,
  }}
>
  <article class="essay h-entry">
    <header class="essay__header">
      <h1 class="essay__h1 p-name">{title}</h1>
      {subtitle && <p class="essay__subtitle p-summary">{subtitle}</p>}
      <p class="essay__meta">
        <time class="dt-published" datetime={published.toISOString()}>{dateFmt(published)}</time>
        {updated && (
          <>
            <span aria-hidden="true"> · </span>
            <time class="dt-updated" datetime={updated.toISOString()}>updated {dateFmt(updated)}</time>
          </>
        )}
        {readingMinutes && readingMinutes >= 1 && (
          <>
            <span aria-hidden="true"> · </span>
            <span class="essay__reading-time">{readingMinutes} min read</span>
          </>
        )}
      </p>
    </header>
    <div class="essay__body e-content">
      <slot />
    </div>
    {relatedEntries.length > 0 && (
      <aside class="essay__related" aria-label="Related writing">
        <h2 class="essay__related-h2">Related</h2>
        <ul class="essay__related-list">
          {relatedEntries.map((r) => {
            const rSlug = r.id.replace(/\.md$/, '');
            const href = r.collection === 'essays' ? `/essays/${rSlug}` : `/notes/${rSlug}`;
            return (
              <li>
                <a href={href} class="essay__related-link">
                  <span class="essay__related-collection">{r.collection === 'essays' ? 'Essay' : 'Note'}</span>
                  <span class="essay__related-title">{r.data.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .essay {
    max-width: 65ch;
    margin: 0 auto;
    padding: var(--spacing-2xl) var(--spacing-lg);
    font-family: var(--font-body);
    color: var(--color-charcoal);
  }
  .essay__h1 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1.15;
    margin: 0 0 var(--spacing-sm) 0;
    color: var(--color-charcoal);
  }
  .essay__subtitle {
    font-size: 1.125rem;
    color: var(--color-charcoal-mid);
    margin: 0 0 var(--spacing-md) 0;
  }
  .essay__meta {
    font-size: var(--text-meta);
    color: var(--color-muted);
    margin: 0 0 var(--spacing-2xl) 0;
  }
  .essay__body {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .essay__body :global(p) { margin: 0 0 var(--spacing-md) 0; }
  .essay__body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin: var(--spacing-2xl) 0 var(--spacing-sm) 0;
  }
  .essay__body :global(h3) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: var(--spacing-xl) 0 var(--spacing-sm) 0;
  }
  .essay__body :global(a) {
    color: var(--color-green);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .essay__body :global(blockquote) {
    border-left: 3px solid var(--color-green);
    padding-left: var(--spacing-md);
    color: var(--color-charcoal-mid);
    margin: var(--spacing-lg) 0;
  }
  .essay__body :global(code) {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
    background: var(--color-cream-card);
    padding: 0.1em 0.3em;
    border-radius: 3px;
  }
  .essay__related {
    margin-top: var(--spacing-3xl);
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--color-cream-border);
  }
  .essay__related-h2 {
    font-family: var(--font-body);
    font-size: var(--text-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-charcoal);
    margin: 0 0 var(--spacing-md) 0;
  }
  .essay__related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  .essay__related-link {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-sm);
    color: var(--color-charcoal);
    text-decoration: none;
  }
  .essay__related-link:hover { text-decoration: underline; }
  .essay__related-collection {
    font-size: var(--text-meta);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
</style>
