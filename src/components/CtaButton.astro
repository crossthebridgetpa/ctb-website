---
/**
 * CtaButton.astro — primary CTA used on the homepage hero and contact surface.
 *
 * Phase 1 has only the `primary` variant (UI-SPEC §5). The button clears the
 * 44px touch-target requirement at 48px total height (16px font + 2×16px
 * vertical padding via --spacing-md, line-height 1.0).
 *
 * Focus ring is the gold token's earned use: green outline + gold-glow box-shadow.
 * Active translateY is wrapped in prefers-reduced-motion: no-preference.
 */
interface Props {
  href: string;
  ariaLabel?: string;
}
const { href, ariaLabel } = Astro.props;
---
<a href={href} class="cta-primary" aria-label={ariaLabel}>
  <slot />
</a>

<style>
  .cta-primary {
    display: inline-block;
    background: var(--color-green);
    color: var(--color-cream);
    padding: var(--spacing-md) var(--spacing-lg);
    font-family: var(--font-body);
    font-size: 1rem; /* 16px */
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.01em;
    border-radius: 6px;
    text-decoration: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cta-primary {
      transition: background-color 200ms ease-out;
    }
  }
  .cta-primary:hover {
    background: var(--color-green-dark);
  }
  .cta-primary:focus-visible {
    outline: 2px solid var(--color-green);
    outline-offset: 3px;
    box-shadow: 0 0 0 4px var(--color-gold-light);
  }
  @media (prefers-color-scheme: dark) {
    .cta-primary:focus-visible {
      box-shadow: 0 0 0 4px var(--color-gold);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cta-primary:active {
      transform: translateY(1px);
    }
  }
  @media (max-width: 479px) {
    .cta-primary {
      display: block;
      width: 100%;
      text-align: center;
    }
  }
</style>
